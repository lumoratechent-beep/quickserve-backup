
{
  "crons": [
    {
      "path": "/api/stripe/billing?action=cleanup-stale",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/orders/report?action=e-receipts-cleanup",
      "schedule": "15 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/e-receipt",
      "destination": "/api/orders/report?action=e-receipt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
